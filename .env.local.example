# Supabase settings for Twiddl Trivia
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=your_random_cron_secret

# The site's public origin, without a trailing slash: https://your-domain.example
#
# Re-engagement emails build their links from this, so it must be the origin the
# recipient can actually open. It is public by nature and is safe to expose; the
# NEXT_PUBLIC_ prefix is only there because the browser also reads it.
#
# Leave it unset in local development (the app falls back to http://localhost:3000)
# and set it in production, or the emailed links will point at the wrong place.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase Auth -> URL Configuration -> Site URL and Redirect URLs.
#
# The re-engagement email's sign-in link goes through /auth/callback, so
# https://your-domain.example/auth/callback must be listed under Redirect URLs
# and https://your-domain.example under Site URL. These live in the Supabase
# dashboard, not in this file, so there is nothing to paste here.

# Server-only Brevo key used by the re-engagement emails. If this is missing or
# Brevo fails, no re-engagement email is sent and the run is logged as failed.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
#
# This is a separate API key from the one Supabase Auth uses as its SMTP relay:
# create it in Brevo -> SMTP & API -> API Keys. The SMTP relay credentials in
# Supabase are untouched by this setting.
BREVO_API_KEY=your_brevo_api_key

# The verified sender address for re-engagement emails. It must match an address
# already verified in Brevo (and therefore already used for Supabase Auth's mail),
# otherwise SPF/DKIM fails and the provider rejects the message.
BREVO_SENDER_EMAIL=you@your-domain.example

# Optional display name for that sender. Defaults to "Twiddl Trivia".
# BREVO_SENDER_NAME=Twiddl Trivia

# Upper bound on messages a single cron run may send. The default is 25.
# REENGAGEMENT_MAX_SENDS=25

# Upper bound on how many candidate rows a single cron run examines. The default
# is 100. Set it low while testing so a mistake cannot email many people.
# REENGAGEMENT_MAX_CANDIDATES=100
#
# The inactivity threshold itself (48 hours) is a constant in
# src/lib/reengagement.ts, not an environment setting.

# Server-only Groq key used by twiddloo to write its daily question. If this is missing or
# Groq fails, twiddloo posts a question from its static list instead. Never expose this to the
# browser and never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=your_groq_api_key

# PostHog product analytics (optional - Twiddl runs normally with these unset).
#
# NEXT_PUBLIC_POSTHOG_KEY   Project ingestion token from PostHog -> Project settings -> Project
#                           API key. This is the *project* token, which is safe to expose to the
#                           browser. Never put a PostHog *personal* API key here, and never put
#                           SUPABASE_SERVICE_ROLE_KEY here either.
# NEXT_PUBLIC_POSTHOG_HOST  Regional ingestion host: https://us.i.posthog.com for US Cloud or
#                           https://eu.i.posthog.com for EU Cloud.
# NEXT_PUBLIC_POSTHOG_ENABLED
#                           Must be exactly "true" to capture. Analytics stays off when this is
#                           unset OR when the key/host is missing, so local development, tests
#                           and Vercel preview deployments stay out of the production dataset by
#                           default. Set it to "true" only in the Vercel Production environment;
#                           to test, point a Preview deployment at a separate PostHog project.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=false
